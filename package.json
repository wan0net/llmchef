{
  "name": "llmchef",
  "private": true,
  "version": "0.2.13-beta",
  "type": "module",
  "homepage": "https://wan0.net/llmchef",
  "repository": {
    "type": "git",
    "url": "https://github.com/wan0net/llmchef.git"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "export VITE_SYSTEM_PROMPT_FILE=system-prompt.txt && tsc --noEmit --skipLibCheck && vite build",
    "build:en": "VITE_APP_LANG=en npm run build",
    "build:fr": "VITE_APP_LANG=fr npm run build",
    "build:all": "npm run build:en && npm run build:fr",
    "build:pages": "VITE_BASE=/llmchef/ npm run build",
    "lint": "node scripts/lint-touched.mjs",
    "lint:all": "eslint . --max-warnings=0",
    "fitness:architecture": "node scripts/check-architecture-fitness.mjs",
    "budget": "node scripts/check-bundle-budget.mjs",
    "roadmap:sync": "node scripts/sync-roadmap-issues.mjs",
    "kanban:sync": "python3 scripts/sync-github-kanban-issues.py",
    "kanban:sync:write": "python3 scripts/sync-github-kanban-issues.py --write",
    "preview": "vite preview",
    "test": "DEBUG_PRINT_LIMIT=10000 vitest",
    "test:e2e": "playwright test",
    "test:ui": "DEBUG_PRINT_LIMIT=10000 vitest --ui",
    "coverage": "DEBUG_PRINT_LIMIT=10000 vitest run --coverage",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "release:local": "npm run version:check && npm run vendor:pyodide && npm run build && bin/releaser",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "version:check": "node scripts/check-version-consistency.mjs",
    "deploy": "npm run release:local && npm run build:pages && npm run release:verify && gh-pages -d dist --no-history --dotfiles",
    "to2web": "npm run deploy",
    "serve": "npm run build && npx http-server dist --port ${LLMCHEF_PORT:=5173}",
    "update": "git pull ${LLMCHEF_ORIGIN:=origin} ${LLMCHEF_BRANCH:=main} && npm install && npm run serve",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "overrides": {
    "elliptic": "^6.6.1",
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0",
    "devalue": "5.8.1"
  },
