    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/jszip": "^3.4.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.1.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.9",
