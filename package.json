    "jsdom": "^26.1.0",
    "pyodide": "^0.27.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^4.1.8"
  }
}
