#!/bin/bash

# Script to package LLMChef distribution files into release archives
# Creates both latest.zip and version-specific archives
# Usage: ./package-release.sh

set -e  # Exit on any error

# Check for required tools
if ! command -v jq &> /dev/null; then
    echo "Error: jq is required but not installed. Please install jq first."
    exit 1
fi

if ! command -v zip &> /dev/null; then
    echo "Error: zip is required but not installed. Please install zip first."
    exit 1
fi

# Ensure we're in the project root (where package.json is located)
if [ ! -f "package.json" ]; then
    echo "Error: package.json not found. Please run this script from the project root directory."
    exit 1
fi

# Check if dist directory exists
if [ ! -d "dist" ]; then
    echo "Error: dist/ directory not found. Please build the project first."
    exit 1
fi

# Create public/release directory if it doesn't exist
mkdir -p public/release

# Extract version from package.json
VERSION=$(jq -r .version package.json)
if [ -z "$VERSION" ] || [ "$VERSION" == "null" ]; then
    echo "Error: Could not extract version from package.json"
    exit 1
fi

echo "Packaging LLMChef v${VERSION}..."

PYODIDE_VERSION="${VITE_PYODIDE_VERSION:-0.27.7}"
if [ ! -f "dist/pyodide/v${PYODIDE_VERSION}/full/pyodide.js" ]; then
    echo "Warning: dist/pyodide/v${PYODIDE_VERSION}/full/pyodide.js not found."
    echo "         Runnable Python blocks will not work from this release unless Pyodide is vendored."
    echo "         Run: npm install --save-dev pyodide@${PYODIDE_VERSION} && npm run vendor:pyodide && npm run build"
fi

# Create temp directory for packaging
TEMP_DIR=$(mktemp -d)
trap 'rm -rf -- "$TEMP_DIR"' EXIT

# Copy distribution files to temp directory
echo "Copying distribution files..."
cp -r dist/* "$TEMP_DIR/"

cat > "$TEMP_DIR/LOCAL-FIRST.md" <<EOF
# LLMChef Local Bundle

Serve this directory from a local static server and open it in your browser.

The app is static and local-first. Same-origin assets and loopback hosts are allowed by default. Remote hosts are blocked by the runtime fetch guard unless they are configured as providers, service URLs, MCP servers, marketplace sources, remote mods, or sync repositories.

Runnable Python blocks require Pyodide at /pyodide/v${PYODIDE_VERSION}/full/pyodide.js inside this bundle.
EOF

rm -rf "$TEMP_DIR/release/";
rm -rf "$TEMP_DIR/versions/";
rm -rf "$TEMP_DIR/icons/1024.png";

# Create the release zip file
echo "Creating ZIP archive..."
cd "$TEMP_DIR";
zip -r "../llmchef-latest.zip" ./* -q
cd - > /dev/null

# Copy the zip files to public/release/
echo "Copying ZIP archives to public/release/..."
rm -f "public/release/latest.zip"
cp "$TEMP_DIR/../llmchef-latest.zip" "public/release/latest.zip"
rm -f "public/release/llmchef-${VERSION}.zip"
cp "public/release/latest.zip" "public/release/llmchef-${VERSION}.zip"

rm "$TEMP_DIR/../llmchef-latest.zip"

# Output file sizes
LATEST_SIZE=$(du -h "public/release/latest.zip" | cut -f1)
VERSION_SIZE=$(du -h "public/release/llmchef-${VERSION}.zip" | cut -f1)

echo "✅ Release packaging complete!"
echo "📦 Created: public/release/latest.zip (${LATEST_SIZE})"
echo "📦 Created: public/release/llmchef-${VERSION}.zip (${VERSION_SIZE})"
echo "📋 Version: ${VERSION}"
